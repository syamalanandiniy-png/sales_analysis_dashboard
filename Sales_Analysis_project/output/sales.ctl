options (skip=1)

LOAD DATA
INFILE 'cleaned_sales_data.csv'
INTO TABLE SALES_ANALYSIS
APPEND
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
    ORDER_ID,
    ORDER_DATE DATE "YYYY-MM-DD",
    PRODUCT,
    CATEGORY,
    CITY,
    QUANTITY,
    PRICE,
    REVENUE,
    MONTH
)